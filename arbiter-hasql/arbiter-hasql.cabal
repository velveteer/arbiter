cabal-version:   3.0
name:            arbiter-hasql
version:         0.1.0.0
synopsis:        hasql backend for Arbiter
description:
  A hasql backend for Arbiter, a PostgreSQL job queue for Haskell.

  Provides @HasqlDb@, a @MonadArbiter@ monad over a hasql connection pool, with
  savepoint-based nested transactions and prepared statements for the hot path
  (on by default). Single-job handlers receive the connection of the worker
  transaction that acks the job. @inTransaction@ runs Arbiter operations in a
  transaction the application already opened. The query, statement,
  transaction, and handler primitives in "Arbiter.Hasql.MonadArbiter" are for
  applications that write their own instance.

license:         MIT
license-file:    LICENSE
author:          Joshua Miller
maintainer:      joshua.ian.miller@pm.me
category:        Database
build-type:      Simple
tested-with:     GHC >=9.10 && <9.11 || >=9.12 && <9.13 || >=9.14 && <9.15
extra-doc-files:
  CHANGELOG.md
  README.md

homepage:        https://github.com/velveteer/arbiter
bug-reports:     https://github.com/velveteer/arbiter/issues

source-repository head
  type:     git
  location: https://github.com/velveteer/arbiter.git
  subdir:   arbiter-hasql

flag hasql2
  description:
    Build against hasql 2, whose transport is a pqi adapter. The flag changes the
    type of toHasqlConnect.
  default:     True
  manual:      True

common shared-properties
  default-language: GHC2024
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-home-modules -Wpartial-fields
    -Wredundant-constraints -Werror=incomplete-patterns
    -Wunused-packages -Wmissing-export-lists -Wunused-type-patterns
    -Wderiving-defaults -Wmissing-deriving-strategies
    -Wmissing-signatures

library
  import:          shared-properties
  hs-source-dirs:  src
  exposed-modules:
    Arbiter.Hasql
    Arbiter.Hasql.Compat
    Arbiter.Hasql.HasqlDb
    Arbiter.Hasql.MonadArbiter

  other-modules:
    Arbiter.Hasql.Decode
    Arbiter.Hasql.Encode

  build-depends:
    , arbiter-core   >=0.1  && <0.2
    , base           >=4.20 && <5
    , bytestring     >=0.10.12 && <0.13
    , exceptions     >=0.10 && <0.11
    , mtl            >=2.2  && <2.4
    , resource-pool  >=0.4  && <0.6
    , text           >=1.2  && <2.2
    , transformers   >=0.5  && <0.7
    , unliftio       >=0.2  && <0.3

  if flag(hasql2)
    build-depends:
      , hasql  >=2.0 && <2.1
      , pqi    >=1.0 && <1.2

  else
    build-depends:
      , arbiter-libpq     >=0.1  && <0.2
      , hasql             >=1.10 && <1.11
      , postgresql-libpq  >=0.10 && <0.12

test-suite arbiter-hasql-tests
  import:         shared-properties
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Spec.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  other-modules:
    Test.Arbiter.Hasql.Concurrency
    Test.Arbiter.Hasql.ConcurrencyLimit
    Test.Arbiter.Hasql.Operations
    Test.Arbiter.Hasql.RateLimit
    Test.Arbiter.Hasql.StateMachine
    Test.Arbiter.Hasql.TestHelpers
    Test.Arbiter.Hasql.Worker

  build-depends:
    , aeson                   >=2.2 && <2.3
    , arbiter-core            >=0.1 && <0.2
    , arbiter-hasql
    , arbiter-test-common     >=0.1 && <0.2
    , arbiter-worker          >=0.1 && <0.2
    , arbiter-worker-testkit  >=0.1 && <0.2
    , base >=4.20 && <5
    , bytestring              >=0.10.12 && <0.13
    , hasql
    , hspec                   >=2.8 && <2.12
    , postgresql-simple       >=0.6 && <0.8
    , resource-pool           >=0.4 && <0.6
    , stm                     >=2.5 && <2.6
    , text                    >=1.2 && <2.2
    , unliftio                >=0.2 && <0.3

  if flag(hasql2)
    build-depends:
      , pqi         >=1.0 && <1.2
      , pqi-ffi     >=1.0 && <1.1
      , pqi-native  >=1.0 && <1.1
