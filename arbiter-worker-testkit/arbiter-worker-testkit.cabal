cabal-version:   3.0
name:            arbiter-worker-testkit
version:         0.1.0.0
synopsis:        Backend-parameterized worker-pool test suite for arbiter
description:
  Worker conformance tests for Arbiter, an opinionated PostgreSQL job queue for
  Haskell.

  A worker-pool test suite parameterized over a @MonadArbiter@ runner, so a new
  backend can be checked against the same behavior the shipped backends are held
  to. Requires a live PostgreSQL database.

license:         MIT
license-file:    LICENSE
author:          Joshua Miller
maintainer:      joshua.ian.miller@pm.me
category:        Testing
build-type:      Simple
tested-with:     GHC >=9.10 && <9.11 || >=9.12 && <9.13 || >=9.14 && <9.15
extra-doc-files:
  CHANGELOG.md
  README.md

homepage:        https://github.com/velveteer/arbiter
bug-reports:     https://github.com/velveteer/arbiter/issues

source-repository head
  type:     git
  location: https://github.com/velveteer/arbiter.git

common shared-properties
  default-language: GHC2024
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-home-modules -Wpartial-fields
    -Wredundant-constraints -Werror=incomplete-patterns
    -Wunused-packages -Wmissing-export-lists -Wunused-type-patterns
    -Wderiving-defaults -Wmissing-deriving-strategies
    -Wmissing-signatures

library
  import:          shared-properties
  hs-source-dirs:  src
  exposed-modules: Arbiter.Worker.TestKit
  build-depends:
    , aeson              >=2.0  && <2.3
    , arbiter-core       >=0.1  && <0.2
    , arbiter-worker     >=0.1  && <0.2
    , base               >=4.20 && <5
    , bytestring         >=0.10 && <0.13
    , hspec              >=2.0  && <2.12
    , postgresql-simple  >=0.6  && <0.8
    , text               >=1.2  && <2.2
    , unliftio           >=0.2  && <0.3

test-suite arbiter-worker-testkit-tests
  import:         shared-properties
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Spec.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  other-modules:
    Test.Arbiter.Worker
    Test.Arbiter.Worker.MultiQueueListener
    Test.Arbiter.Worker.PlainResult
    Test.Arbiter.Worker.SharedListener

  build-depends:
    , aeson
    , arbiter-core            >=0.1 && <0.2
    , arbiter-simple          >=0.1 && <0.2
    , arbiter-test-common     >=0.1 && <0.2
    , arbiter-worker          >=0.1 && <0.2
    , arbiter-worker-testkit
    , base
    , bytestring
    , containers
    , directory
    , hspec
    , postgresql-simple
    , resource-pool
    , text
    , time
    , unliftio
    , uuid
