packages:
  arbiter-core
  arbiter-migrations
  arbiter-worker
  arbiter-simple
  arbiter-hasql
  arbiter-libpq
  arbiter-orville
  arbiter-servant
  arbiter-servant-openapi
  arbiter-servant-ui
  arbiter-otel
  arbiter-demo
  arbiter-test
  arbiter-bench

-- GHC 9.14 ships base 4.22 and template-haskell 2.24, ahead of the upper
-- bounds some deps (postgresql-simple) still declare.
allow-newer:
  base,
  template-haskell

multi-repl: True
tests: True
benchmarks: True
