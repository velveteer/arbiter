packages:
  arbiter-core
  arbiter-migrations
  arbiter-worker
  arbiter-simple
  arbiter-hasql
  arbiter-orville
  arbiter-servant
  arbiter-servant-ui
  arbiter-serve
  arbiter-cli
  arbiter-demo
  arbiter-test-common
  arbiter-bench

with-compiler: ghc-9.14.1

-- GHC 9.14 ships base 4.22 and template-haskell 2.24, ahead of the upper
-- bounds some deps (postgresql-simple) still declare.
allow-newer:
  base,
  template-haskell

multi-repl: True
tests: True
