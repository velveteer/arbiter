cabal-version:   3.0
name:            arbiter-worker
version:         0.1.0.0
synopsis:        Worker framework for arbiter
description:
  Worker pools for Arbiter, an opinionated PostgreSQL job queue for Haskell.

  Runs concurrent pools that claim jobs under a visibility timeout, heartbeat
  long-running work, retry with a configurable backoff strategy, and move
  exhausted jobs to the dead-letter queue. Includes cron scheduling, background
  maintenance, graceful drain, observability callbacks, structured logging, and
  file-based liveness probes.

license:         MIT
license-file:    LICENSE
author:          Joshua Miller
maintainer:      joshua.ian.miller@pm.me
category:        Database
build-type:      Simple
tested-with:     GHC >=9.10 && <9.11 || >=9.12 && <9.13 || >=9.14 && <9.15
extra-doc-files:
  CHANGELOG.md
  README.md

homepage:        https://github.com/velveteer/arbiter
bug-reports:     https://github.com/velveteer/arbiter/issues

source-repository head
  type:     git
  location: https://github.com/velveteer/arbiter.git

common shared-properties
  default-language: GHC2024
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-home-modules -Wpartial-fields
    -Wredundant-constraints -Werror=incomplete-patterns
    -Wunused-packages -Wmissing-export-lists -Wunused-type-patterns
    -Wderiving-defaults -Wmissing-deriving-strategies
    -Wmissing-signatures

library
  import:          shared-properties
  hs-source-dirs:  src
  exposed-modules:
    Arbiter.Worker
    Arbiter.Worker.BackoffStrategy
    Arbiter.Worker.Config
    Arbiter.Worker.Cron
    Arbiter.Worker.Batch
    Arbiter.Worker.Heartbeat
    Arbiter.Worker.Heartbeat.Guard
    Arbiter.Worker.Logger
    Arbiter.Worker.WorkQueue

  other-modules:
    Arbiter.Worker.ChannelHandlers
    Arbiter.Worker.Cron.Scheduler
    Arbiter.Worker.Cron.Types
    Arbiter.Worker.Dispatcher
    Arbiter.Worker.EnabledQueues
    Arbiter.Worker.MultiQueue
    Arbiter.Worker.Logger.Internal
    Arbiter.Worker.NotificationListener
    Arbiter.Worker.Pool
    Arbiter.Worker.Processing
    Arbiter.Worker.Reaper
    Arbiter.Worker.Results
    Arbiter.Worker.Retry
    Arbiter.Worker.Settlement
    Arbiter.Worker.WorkerState

  build-depends:
    , aeson               >=2.0  && <2.3
    , arbiter-core        >=0.1  && <0.2
    , base                >=4.20 && <5
    , containers          >=0.6  && <0.9
    , cron                >=0.7  && <0.9
    , directory           >=1.3  && <1.4
    , fast-logger         >=3.0  && <3.3
    , hostname            >=1.0  && <1.1
    , io-classes          >=1.11 && <1.12
    , io-classes:si-timers
    , monad-logger        >=0.3  && <0.4
    , monad-logger-aeson  >=0.4  && <0.5
    , random              >=1.2  && <1.4
    , stm                 >=2.5  && <2.6
    , text                >=1.2  && <2.2
    , time                >=1.9  && <1.16
    , transformers        >=0.5  && <0.7
    , tz                  >=0.1  && <0.2
    , unliftio            >=0.2  && <0.3
    , uuid                >=1.3  && <1.4

test-suite arbiter-worker-tests
  import:         shared-properties
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Spec.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  other-modules:
    Test.Arbiter.Worker.Concurrency
    Test.Arbiter.Worker.ConnectionRecovery
    Test.Arbiter.Worker.Cron
    Test.Arbiter.Worker.BatchSim
    Test.Arbiter.Worker.Deadline
    Test.Arbiter.Worker.GuardSim
    Test.Arbiter.Worker.Logging
    Test.Arbiter.Worker.MultiQueue
    Test.Arbiter.Worker.PoolSizing
    Test.Arbiter.Worker.Sim
    Test.Arbiter.Worker.WorkQueue

  build-depends:
    , aeson
    , arbiter-core         >=0.1 && <0.2
    , arbiter-simple       >=0.1 && <0.2
    , arbiter-test-common  >=0.1 && <0.2
    , arbiter-worker
    , base
    , bytestring
    , containers
    , cron
    , hspec
    , io-classes
    , io-classes:si-timers
    , io-sim
    , postgresql-simple
    , QuickCheck
    , resource-pool
    , text
    , time
    , unliftio
