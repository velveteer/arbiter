cabal-version:      2.4
name:               arbiter-servant-ui
version:            0.1.0.0
synopsis:           Embedded admin dashboard for arbiter job queue
description:
  Admin dashboard for Arbiter, an opinionated PostgreSQL job queue for Haskell.
  A browser interface over the arbiter-servant API for inspecting and operating
  queues: job, dead-letter, and archive browsing, retries and cancellation, cron
  schedules, rate-limit and concurrency policies, queue pausing, and worker
  health. Assets are embedded in the binary, so there are no runtime file
  dependencies.

license:            MIT
license-file:       LICENSE
author:             Joshua Miller
maintainer:         joshua.ian.miller@pm.me
category:           Web
build-type:         Simple
tested-with:        GHC >=9.10 && <9.11 || >=9.12 && <9.13 || >=9.14 && <9.15
extra-doc-files:
  CHANGELOG.md
  README.md

extra-source-files:
  static/apple-touch-icon.png
  static/arbiter-mark.svg
  static/css/*.css
  static/favicon.ico
  static/favicon.svg
  static/index.html
  static/js/*.js
  static/vendor/*.css
  static/vendor/*.js
  static/vendor/fonts/*.css
  static/vendor/fonts/*.woff2

homepage:           https://github.com/velveteer/arbiter
bug-reports:        https://github.com/velveteer/arbiter/issues

source-repository head
  type:     git
  location: https://github.com/velveteer/arbiter.git

common shared-properties
  default-language: GHC2024
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-home-modules -Wpartial-fields
    -Wredundant-constraints -Werror=incomplete-patterns
    -Wunused-packages -Wmissing-export-lists -Wunused-type-patterns
    -Wderiving-defaults -Wmissing-deriving-strategies
    -Wmissing-signatures

library
  import:          shared-properties
  hs-source-dirs:  src
  exposed-modules: Arbiter.Servant.UI
  build-depends:
    , arbiter-servant  <0.2
    , base             >=4.20   && <5
    , bytestring       >=0.10   && <0.13
    , file-embed       >=0.0.10 && <0.1
    , filepath         >=1.4    && <1.6
    , hashable         >=1.4    && <1.6
    , http-types       >=0.12   && <0.13
    , servant-server   >=0.19   && <0.21
    , text             >=1.2    && <2.2
    , wai              >=3.2    && <3.3
