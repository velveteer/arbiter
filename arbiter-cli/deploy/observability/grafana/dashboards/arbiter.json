{
  "uid": "arbiter",
  "title": "Arbiter",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Queue depth by status",
      "datasource": {
        "type": "prometheus",
        "uid": "arbiter-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue, status) (arbiter_queue_depth)",
          "legendFormat": "{{queue}} / {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Oldest ready job age (backlog latency)",
      "datasource": {
        "type": "prometheus",
        "uid": "arbiter-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue) (arbiter_queue_oldest_ready_age)",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Jobs processed /s by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "arbiter-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(arbiter_jobs_processed[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Handler duration p95",
      "datasource": {
        "type": "prometheus",
        "uid": "arbiter-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, queue) (rate(arbiter_job_handler_duration_bucket[5m])))",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Dead tuples by table (vacuum pressure)",
      "datasource": {
        "type": "prometheus",
        "uid": "arbiter-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (table) (arbiter_pg_table_dead_tuples)",
          "legendFormat": "{{table}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Postgres connections by state",
      "datasource": {
        "type": "prometheus",
        "uid": "arbiter-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (state) (arbiter_pg_connections)",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Cache hit ratio (5m)",
      "description": "Windowed, not lifetime: the raw counters are cumulative, so a lifetime average would barely move during a miss storm.",
      "datasource": {
        "type": "prometheus",
        "uid": "arbiter-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(arbiter_pg_blocks{source=\"hit\"}[5m])) / clamp_min(sum(rate(arbiter_pg_blocks[5m])), 1)"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Oldest open transaction",
      "datasource": {
        "type": "prometheus",
        "uid": "arbiter-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(arbiter_pg_oldest_transaction_age)"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Transaction-id age (wraparound headroom)",
      "datasource": {
        "type": "prometheus",
        "uid": "arbiter-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(arbiter_pg_xid_age)"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Recent job traces (click a traceID to open the waterfall)",
      "datasource": {
        "type": "tempo",
        "uid": "arbiter-tempo"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "arbiter-tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"arbiter|producer|webhook-handler\" }",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    }
  ]
}