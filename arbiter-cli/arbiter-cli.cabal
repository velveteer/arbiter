cabal-version:   3.0
name:            arbiter-cli
version:         0.1.0.0
synopsis:        Standalone CLI and generic (non-Haskell) worker for arbiter
description:     Config-driven binary that runs migrations, serves the REST + UI,
                 and runs generic JSON-payload workers that dispatch jobs to
                 external HTTP handlers.
license:         MIT
author:          Joshua Miller
maintainer:      joshua.ian.miller@pm.me
category:        Database
build-type:      Simple

common shared-properties
  default-language: GHC2024
  default-extensions: StrictData
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-home-modules -Wpartial-fields
    -Wredundant-constraints -Werror=incomplete-patterns
    -Wderiving-defaults -Wmissing-deriving-strategies
    -Wmissing-signatures

library
  import:         shared-properties
  hs-source-dirs: src
  exposed-modules:
    Arbiter.Cli.Config
    Arbiter.Cli.GenericWorker
    Arbiter.Cli.Webhook

  build-depends:
    , aeson          >=2.0 && <2.3
    , arbiter-core   <0.2
    , arbiter-hasql  <0.2
    , arbiter-serve  <0.2
    , arbiter-worker <0.2
    , base           >=4.14 && <5
    , bytestring     >=0.10 && <0.13
    , containers     >=0.6  && <0.9
    , crypton        >=0.34 && <1.1
    , http-client    >=0.7  && <0.8
    , http-types     >=0.12 && <0.13
    , memory         >=0.18 && <0.19
    , stm            >=2.5  && <2.6
    , text           >=1.2  && <2.2
    , time           >=1.9  && <1.16
    , toml-parser    >=2.0  && <2.1
    , transformers   >=0.5  && <0.7

executable arbiter
  import:         shared-properties
  hs-source-dirs: app
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , aeson
    , arbiter-cli
    , arbiter-core
    , arbiter-hasql
    , arbiter-migrations
    , arbiter-servant
    , arbiter-servant-ui
    , arbiter-serve
    , arbiter-worker
    , base
    , bytestring
    , containers
    , http-client
    , http-client-tls
    , optparse-applicative
    , text

test-suite arbiter-cli-tests
  import:         shared-properties
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Spec.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , aeson
    , arbiter-cli
    , arbiter-core
    , arbiter-hasql
    , arbiter-migrations
    , arbiter-servant
    , arbiter-serve
    , arbiter-test-common
    , arbiter-worker
    , async
    , base
    , bytestring
    , containers
    , hspec
    , http-client
    , http-types
    , postgresql-simple
    , temporary
    , text
    , time
    , warp
