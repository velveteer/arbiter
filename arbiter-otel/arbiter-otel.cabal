cabal-version:   3.0
name:            arbiter-otel
version:         0.1.0.0
synopsis:        OpenTelemetry traces, metrics, and logs for arbiter
description:
  OpenTelemetry for Arbiter, an opinionated PostgreSQL job queue for Haskell.

  Exports job, worker, queue-depth, admission, and database-health instruments
  over OTLP, tees structured logs to the OpenTelemetry log pipeline, and resolves
  the tracer that arbiter-core's built-in job spans emit through. Configuration
  comes from the standard @OTEL_@ environment variables.

license:         MIT
license-file:    LICENSE
author:          Joshua Miller
maintainer:      joshua.ian.miller@pm.me
category:        Database
build-type:      Simple
tested-with:     GHC >=9.10 && <9.11 || >=9.12 && <9.13 || >=9.14 && <9.15
extra-doc-files:
  CHANGELOG.md
  README.md

homepage:        https://github.com/velveteer/arbiter
bug-reports:     https://github.com/velveteer/arbiter/issues

source-repository head
  type:     git
  location: https://github.com/velveteer/arbiter

common shared-properties
  default-language:   GHC2024
  default-extensions: StrictData
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-home-modules -Wpartial-fields
    -Wredundant-constraints -Werror=incomplete-patterns
    -Wunused-packages -Wmissing-export-lists -Wunused-type-patterns
    -Wderiving-defaults -Wmissing-deriving-strategies
    -Wmissing-signatures

library
  import:          shared-properties
  hs-source-dirs:  src
  exposed-modules:
    Arbiter.Otel
    Arbiter.Otel.Gauges
    Arbiter.Otel.Gauges.Cells
    Arbiter.Otel.Logs
    Arbiter.Otel.MetricNames
    Arbiter.Otel.Metrics
    Arbiter.Otel.Telemetry

  build-depends:
    , aeson                 >=2.0  && <2.3
    , arbiter-core          >=0.1  && <0.2
    , arbiter-worker        >=0.1  && <0.2
    , base                  >=4.20 && <5
    , hs-opentelemetry-api  >=1.0  && <1.1
    , hs-opentelemetry-sdk  >=1.0  && <1.1
    , scientific            >=0.3  && <0.4
    , stm                   >=2.5  && <2.6
    , text                  >=1.2  && <2.2
    , time                  >=1.9  && <1.16
    , transformers          >=0.5  && <0.7
    , unliftio              >=0.2  && <0.3
    , unordered-containers  >=0.2  && <0.3

test-suite arbiter-otel-tests
  import:         shared-properties
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Spec.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , aeson
    , arbiter-core                     >=0.1 && <0.2
    , arbiter-migrations               >=0.1 && <0.2
    , arbiter-otel
    , arbiter-simple                   >=0.1 && <0.2
    , arbiter-test-common              >=0.1 && <0.2
    , arbiter-worker                   >=0.1 && <0.2
    , base
    , bytestring
    , directory
    , hs-opentelemetry-api
    , hs-opentelemetry-propagator-w3c
    , hs-opentelemetry-sdk
    , hspec
    , postgresql-simple
    , text
    , time
    , unliftio
