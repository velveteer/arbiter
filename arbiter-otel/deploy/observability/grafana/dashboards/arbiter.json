{
  "uid": "arbiter",
  "title": "Arbiter",
  "tags": [
    "arbiter"
  ],
  "links": [
    {
      "title": "Dashboards",
      "type": "dashboards",
      "tags": [
        "arbiter"
      ],
      "asDropdown": false
    }
  ],
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "DS_TEMPO",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "current": {},
        "hide": 0
      },
      {
        "name": "DS_LOKI",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Queue depth by status",
      "description": "Shared reading: one replica scans and every replica exports it. Aggregate it with max, never sum. The statuses partition a queue's rows. Its backlog is their sum.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue, status) (arbiter_queue_depth)",
          "legendFormat": "{{queue}} / {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Oldest job age (waiting vs running)",
      "description": "Shared reading: one replica scans and every replica exports it. Aggregate it with max, never sum. Waiting is the oldest job still to be claimed, blocked ones included, running is the longest-held lease. Both read 0 when the queue holds nothing in that state. A flat zero means idle rather than instant.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue) (arbiter_queue_oldest_ready_age_seconds)",
          "legendFormat": "{{queue}} / waiting"
        },
        {
          "refId": "B",
          "expr": "max by (queue) (arbiter_queue_oldest_in_flight_age_seconds)",
          "legendFormat": "{{queue}} / running"
        }
      ]
    },
    {
      "id": 29,
      "type": "timeseries",
      "title": "Queue depth by payload variant",
      "description": "Shared reading. Aggregate it with max, never sum. Only the labels the payload declares get a series. Unlabelled rows and labels outside that set are left out: these sum to the queue depth only when every row carries a declared label.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue, kind) (arbiter_queue_depth_by_kind)",
          "legendFormat": "{{queue}} / {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Jobs processed /s by outcome (retries are not terminal)",
      "description": "Counted per worker process. Sum it across replicas. One count per claim that ends in neither a retry nor a release. A retried or released job appears again under the outcome its next claim reaches. A spawning job counts a success when it suspends and another when its finalizer runs. Unavailable is a lost lease, and another claim may settle the job. Reaper DLQ moves are not counted here.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(arbiter_jobs_processed_total[5m]))",
          "legendFormat": "{{outcome}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(arbiter_jobs_retried_total[5m]))",
          "legendFormat": "retry (rescheduled)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Handler duration p95",
      "description": "The handler's own runtime, per queue, for runs that ended in an ack, a spawn, a retry or a DLQ move. A quantile over 5m bucket rates. A queue with no traffic in the window drops out rather than reading 0. The top finite bucket is one hour.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, queue) (rate(arbiter_jobs_handler_duration_seconds_bucket[5m])))",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Jobs claimed /s by queue",
      "description": "Counted per worker process. Sum it across replicas.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (rate(arbiter_jobs_claimed_total[5m]))",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 18,
      "type": "state-timeline",
      "title": "Registered pools by state",
      "description": "One series per queue and state, counting registered worker pools rather than worker threads: a process serving a queue is one pool however many threads it runs. Active means a fresh heartbeat, not shutting down and not paused. An idle pool with no jobs to work on still counts. Shared reading: one replica scans and every replica exports it. Aggregate it with max, never sum.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 70
          }
        }
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.9,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue, state) (arbiter_workers)",
          "legendFormat": "{{queue}} / {{state}}"
        }
      ]
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Dead-letter depth by queue",
      "description": "Shared reading: one replica scans and every replica exports it. Aggregate it with max, never sum. Jobs waiting in each queue's dead-letter table.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue) (arbiter_queue_dlq_depth)",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 32,
      "type": "state-timeline",
      "title": "Paused queues",
      "description": "Shared reading: one replica scans and every replica exports it. Aggregate it with max, never sum. The queue's own pause flag. A paused queue claims nothing, whatever its workers' state.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "running",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "paused",
                  "color": "orange",
                  "index": 1
                }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue) (arbiter_queue_paused_ratio)",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Admission: concurrency slots per key",
      "description": "Shared reading: one replica scans and every replica exports it. Aggregate it with max, never sum. The cap is per key. Read the fullest key against it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "axisLabel": "slots per key"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "B",
          "expr": "max by (policy) (arbiter_admission_limit{policy_kind=\"concurrency\"})",
          "legendFormat": "{{policy}} cap per key"
        },
        {
          "refId": "C",
          "expr": "max by (policy) (arbiter_admission_busiest_key)",
          "legendFormat": "{{policy}} fullest key"
        }
      ]
    },
    {
      "id": 28,
      "type": "timeseries",
      "title": "Admission: concurrency jobs in flight",
      "description": "Shared reading: one replica scans and every replica exports it. Aggregate it with max, never sum. Counts every key at once and is not comparable to the per-key cap.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "axisLabel": "jobs"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (policy) (arbiter_admission_in_flight)",
          "legendFormat": "{{policy}} in flight"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Admission: rate-limit tokens left",
      "description": "Shared reading: one replica scans and every replica exports it. Aggregate it with max, never sum. Buckets refill continuously. The emptiest one is what admission is waiting on.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (policy) (arbiter_admission_tokens{stat=\"min\"})",
          "legendFormat": "{{policy}} emptiest bucket"
        },
        {
          "refId": "B",
          "expr": "max by (policy) (arbiter_admission_tokens{stat=\"avg\"})",
          "legendFormat": "{{policy}} mean bucket"
        },
        {
          "refId": "C",
          "expr": "max by (policy) (arbiter_admission_limit{policy_kind=\"rate_limit\"})",
          "legendFormat": "{{policy}} bucket size"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Admission: jobs through each policy /s",
      "description": "Counted per worker process. Sum it across replicas. Jobs a policy admitted, not jobs it held back.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (policy_kind, policy) (rate(arbiter_admission_admitted_total[5m]))",
          "legendFormat": "{{policy_kind}} {{policy}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Reaper rows /s by op",
      "description": "Counted per worker process. Sum it across replicas. Rows each op actually touched, and a flat zero means nothing needed repairing. refresh-all-groups also counts a group whose lease or backoff lapsed before a claim, routine in a queue with many retries. sweep-exhausted-jobs counts the descendants a rollup takes to the DLQ.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (op) (rate(arbiter_maintenance_rows_total[5m]))",
          "legendFormat": "{{op}}"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Admission: live keys by policy",
      "description": "Shared reading: one replica scans and every replica exports it. Aggregate it with max, never sum. Keyed by policy prefix, never by admission key.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 56
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (policy_kind, policy) (arbiter_admission_keys)",
          "legendFormat": "{{policy_kind}} / {{policy}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Gauge reading age",
      "description": "How stale the queue, worker, admission and table readings are. Climbing past the refresh interval means the scan stopped, not that the queues went quiet.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 56
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 45
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(arbiter_gauges_age_seconds)"
        }
      ]
    },
    {
      "id": 30,
      "type": "stat",
      "title": "Database reachable",
      "description": "0 when the last gauge scan did not reach the database. Aggregate it with min to surface a replica that cannot reach it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 56
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "unreachable",
                  "index": 0
                },
                "1": {
                  "text": "reachable",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(arbiter_pg_database_reachable_ratio)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Dead tuples by table (vacuum pressure)",
      "description": "Shared reading: one replica scans and every replica exports it. Aggregate it with max, never sum. A cumulative-statistics estimate, not an exact count.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 64
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (table) (arbiter_pg_table_dead_tuples)",
          "legendFormat": "{{table}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Live tuples by table",
      "description": "Shared reading: one replica scans and every replica exports it. Aggregate it with max, never sum. A cumulative-statistics estimate, not an exact count.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 64
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (table) (arbiter_pg_table_live_tuples)",
          "legendFormat": "{{table}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Total relation size by table",
      "description": "Shared reading: one replica scans and every replica exports it. Aggregate it with max, never sum. Includes indexes and TOAST.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 72
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (table) (arbiter_pg_table_size_bytes)",
          "legendFormat": "{{table}}"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Time since last vacuum by table",
      "description": "Shared reading: one replica scans and every replica exports it. Aggregate it with max, never sum. A table that has never been vacuumed is absent here.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 72
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (table) (arbiter_pg_table_vacuum_age_seconds)",
          "legendFormat": "{{table}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Table transaction-id age (wraparound headroom)",
      "description": "Shared reading: one replica scans and every replica exports it. Aggregate it with max, never sum. How far transaction ids have advanced since the oldest unfrozen row. Postgres stops accepting writes near 2.1 billion. Orange marks the point to look into autovacuum, red the point to act.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 80
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(arbiter_pg_table_xid_age)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000000000
              },
              {
                "color": "red",
                "value": 1500000000
              }
            ]
          }
        }
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Recent job traces (click a traceID to open the waterfall)",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 86
      },
      "timeFrom": "1h",
      "options": {
        "sortBy": [
          {
            "displayName": "Start time",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \".+\" } with (most_recent=true)",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Worker logs (lines emitted inside a job carry its trace)",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 96
      },
      "timeFrom": "1h",
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "{service_name=~\".+\"}",
          "queryType": "range",
          "maxLines": 200
        }
      ]
    }
  ]
}
