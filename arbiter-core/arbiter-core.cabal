cabal-version:   2.2
name:            arbiter-core
version:         0.1.0.0
synopsis:        Core types and logic for PostgreSQL-backed job queue
description:
  Core job and dead-letter queue types, SQL templates, and monadic operations for arbiter.

license:         MIT
author:          Joshua Miller
maintainer:      joshua.ian.miller@pm.me
category:        Database
build-type:      Simple
extra-doc-files: CHANGELOG.md
homepage:        https://github.com/velveteer/arbiter
bug-reports:     https://github.com/velveteer/arbiter/issues

source-repository head
  type:     git
  location: https://github.com/velveteer/arbiter.git

common shared-properties
  default-language: GHC2024
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-home-modules -Wpartial-fields
    -Wredundant-constraints -Werror=incomplete-patterns
    -Wunused-packages -Wmissing-export-lists -Wunused-type-patterns
    -Wderiving-defaults -Wmissing-deriving-strategies
    -Wmissing-signatures

library
  import:          shared-properties
  hs-source-dirs:  src
  exposed-modules:
    Arbiter.Concurrency
    Arbiter.Core
    Arbiter.Core.Admission
    Arbiter.Core.Array
    Arbiter.Core.Codec
    Arbiter.Core.Concurrency.Schema
    Arbiter.Core.Concurrency.Spec
    Arbiter.Core.Concurrency.Stats
    Arbiter.Core.CronSchedule
    Arbiter.Core.Exceptions
    Arbiter.Core.Gates
    Arbiter.Core.HasArbiterSchema
    Arbiter.Core.HighLevel
    Arbiter.Core.Job.DLQ
    Arbiter.Core.Job.Schema
    Arbiter.Core.Job.Types
    Arbiter.Core.JobTree
    Arbiter.Core.Json
    Arbiter.Core.Listen
    Arbiter.Core.MonadArbiter
    Arbiter.Core.Operations
    Arbiter.Core.PoolConfig
    Arbiter.Core.QueueRegistry
    Arbiter.Core.Queues
    Arbiter.Core.RateLimit.Schema
    Arbiter.Core.RateLimit.Spec
    Arbiter.Core.RateLimit.Stats
    Arbiter.Core.Selector
    Arbiter.Core.Sql.Claim
    Arbiter.Core.Sql.Concurrency
    Arbiter.Core.Sql.Cron
    Arbiter.Core.Sql.DLQ
    Arbiter.Core.Sql.Gates
    Arbiter.Core.Sql.Groups
    Arbiter.Core.Sql.Jobs
    Arbiter.Core.Sql.Lifecycle
    Arbiter.Core.Sql.Queues
    Arbiter.Core.Sql.RateLimit
    Arbiter.Core.Sql.Stats
    Arbiter.Core.Sql.Tree
    Arbiter.Core.Sql.Workers
    Arbiter.Core.SqlLiterals
    Arbiter.Core.Worker
    Arbiter.RateLimit

  build-depends:
    , aeson               >=2.0  && <2.3
    , base                >=4.14 && <5
    , bytestring          >=0.10 && <0.13
    , containers          >=0.6  && <0.9
    , free                >=5.1  && <5.3
    , neat-interpolation  >=0.5  && <0.6
    , postgresql-libpq    >=0.10 && <0.12
    , postgresql-simple   >=0.6  && <0.8
    , selective           >=0.5  && <0.8
    , stm                 >=2.5  && <2.6
    , text                >=1.2  && <2.2
    , time                >=1.9  && <1.16
    , unliftio            >=0.2  && <0.3
    , uuid-types          >=1.0  && <1.1
