cabal-version:   3.0
name:            arbiter-orville
version:         0.1.0.0
synopsis:        Orville backend integration for arbiter
description:
  An Orville backend for Arbiter, an opinionated PostgreSQL job queue for
  Haskell.

  Provides @OrvilleDb@, a @MonadArbiter@ transformer over any @MonadOrville@
  monad. Arbiter queries run on the application's Orville connection and share
  the transaction Orville is already managing. The query, statement,
  transaction, and handler primitives are exported for applications that write
  their own instance.

license:         MIT
license-file:    LICENSE
author:          Joshua Miller
maintainer:      joshua.ian.miller@pm.me
category:        Database
build-type:      Simple
tested-with:     GHC >=9.10 && <9.11 || >=9.12 && <9.13 || >=9.14 && <9.15
extra-doc-files:
  CHANGELOG.md
  README.md

homepage:        https://github.com/velveteer/arbiter
bug-reports:     https://github.com/velveteer/arbiter/issues

source-repository head
  type:     git
  location: https://github.com/velveteer/arbiter.git

common shared-properties
  default-language: GHC2024
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-home-modules -Wpartial-fields
    -Wredundant-constraints -Werror=incomplete-patterns
    -Wunused-packages -Wmissing-export-lists -Wunused-type-patterns
    -Wderiving-defaults -Wmissing-deriving-strategies
    -Wmissing-signatures

library
  import:          shared-properties
  hs-source-dirs:  src
  exposed-modules:
    Arbiter.Orville
    Arbiter.Orville.MonadArbiter
    Arbiter.Orville.OrvilleDb

  other-modules:   Arbiter.Orville.Array

  build-depends:
    , aeson               >=2.0  && <2.3
    , arbiter-core        >=0.1  && <0.2
    , base                >=4.20 && <5
    , bytestring          >=0.10 && <0.13
    , exceptions          >=0.10 && <0.11
    , orville-postgresql  >=1.0  && <1.2
    , postgresql-libpq    >=0.9  && <0.12
    , text                >=1.2  && <2.2
    , transformers        >=0.5  && <0.7
    , unliftio            >=0.2  && <0.3

test-suite arbiter-orville-tests
  import:         shared-properties
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Spec.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  other-modules:
    Test.Arbiter.Orville.Concurrency
    Test.Arbiter.Orville.ConcurrencyLimit
    Test.Arbiter.Orville.Listener
    Test.Arbiter.Orville.Operations
    Test.Arbiter.Orville.RateLimit
    Test.Arbiter.Orville.StateMachine
    Test.Arbiter.Orville.TestHelpers
    Test.Arbiter.Orville.Worker

  build-depends:
    , aeson
    , arbiter-core            >=0.1 && <0.2
    , arbiter-libpq           >=0.1 && <0.2
    , arbiter-orville
    , arbiter-test-common     >=0.1 && <0.2
    , arbiter-worker-testkit  >=0.1 && <0.2
    , base
    , bytestring
    , hspec                   >=2.0 && <2.12
    , orville-postgresql
    , postgresql-simple
    , resource-pool           >=0.4 && <0.6
    , text
    , transformers
