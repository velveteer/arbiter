cabal-version:   2.2
name:            arbiter-demo
version:         0.1.0.0
synopsis:        Demo application for arbiter-servant with admin UI
license:         MIT
license-file:    LICENSE
author:          Joshua Miller
maintainer:      joshua.ian.miller@pm.me
category:        Web
build-type:      Simple
extra-doc-files: README.md
homepage:        https://github.com/velveteer/arbiter
bug-reports:     https://github.com/velveteer/arbiter/issues

source-repository head
  type:     git
  location: https://github.com/velveteer/arbiter.git

common shared-properties
  default-language: GHC2024
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-home-modules -Wpartial-fields
    -Wredundant-constraints -Werror=incomplete-patterns
    -Wunused-packages -Wmissing-export-lists -Wunused-type-patterns
    -Wderiving-defaults -Wmissing-deriving-strategies
    -Wmissing-signatures

executable arbiter-demo
  import:         shared-properties
  main-is:        Main.hs
  hs-source-dirs: .
  build-depends:
    , aeson                                 >=2.0
    , arbiter-core
    , arbiter-migrations
    , arbiter-otel
    , arbiter-servant
    , arbiter-servant-ui
    , arbiter-simple
    , arbiter-worker
    , async                                 >=2.2
    , base                                  >=4.20 && <5
    , bytestring                            >=0.10
    , hs-opentelemetry-api                  >=1.0  && <1.1
    , hs-opentelemetry-instrumentation-wai  >=1.0  && <1.1
    , postgresql-simple                     >=0.6
    , random                                >=1.2
    , text                                  >=1.2
    , time                                  >=1.9
    , unix                                  >=2.7
    , unordered-containers                  >=0.2  && <0.3
    , wai-cors                              >=0.2
    , wai-extra                             >=3.0
    , warp

  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
