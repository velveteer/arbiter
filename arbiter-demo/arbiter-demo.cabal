cabal-version:   3.0
name:            arbiter-demo
version:         0.1.0.0
synopsis:        Demo application for arbiter-servant with admin UI
description:
  A runnable demonstration of Arbiter workers and the administration UI.

license:         MIT
license-file:    LICENSE
author:          Joshua Miller
maintainer:      joshua.ian.miller@pm.me
category:        Web
build-type:      Simple
tested-with:     GHC >=9.10 && <9.11 || >=9.12 && <9.13 || >=9.14 && <9.15
extra-doc-files: README.md
homepage:        https://github.com/velveteer/arbiter
bug-reports:     https://github.com/velveteer/arbiter/issues

source-repository head
  type:     git
  location: https://github.com/velveteer/arbiter.git
  subdir:   arbiter-demo

common shared-properties
  default-language: GHC2024
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-home-modules -Wpartial-fields
    -Wredundant-constraints -Werror=incomplete-patterns
    -Wunused-packages -Wmissing-export-lists -Wunused-type-patterns
    -Wderiving-defaults -Wmissing-deriving-strategies
    -Wmissing-signatures

executable arbiter-demo
  import:         shared-properties
  main-is:        Main.hs
  hs-source-dirs: .
  build-depends:
    , aeson                                 >=2.2   && <2.3
    , arbiter-core                          >=0.1   && <0.2
    , arbiter-migrations                    >=0.1   && <0.2
    , arbiter-otel                          >=0.1   && <0.2
    , arbiter-servant                       >=0.1   && <0.2
    , arbiter-servant-openapi               >=0.1   && <0.2
    , arbiter-servant-ui                    >=0.1   && <0.2
    , arbiter-simple                        >=0.1   && <0.2
    , arbiter-worker                        >=0.1   && <0.2
    , async                                 >=2.2   && <2.3
    , base                                  >=4.20  && <5
    , bytestring                            >=0.10.12 && <0.13
    , hs-opentelemetry-api                  >=1.0   && <1.1
    , hs-opentelemetry-instrumentation-wai  >=1.0   && <1.1
    , openapi3                              >=3.2   && <3.3
    , postgresql-simple                     >=0.6   && <0.8
    , random                                >=1.2   && <1.4
    , servant-server                        >=0.19  && <0.21
    , servant-swagger-ui                    >=0.3.5 && <0.4
    , text                                  >=1.2   && <2.2
    , time                                  >=1.12  && <1.16
    , unix                                  >=2.7   && <2.9
    , unordered-containers                  >=0.2   && <0.3
    , wai-cors                              >=0.2   && <0.3
    , wai-extra                             >=3.0   && <3.2
    , warp                                  >=3.3   && <3.5

  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
