cabal-version:   3.0
name:            arbiter-serve
version:         0.1.0.0
synopsis:        Production serve harness for arbiter
description:     Runs an arbiter deployment's REST API and worker pools together,
                 with health probes, OpenTelemetry metrics and tracing, queue-depth
                 gauges, and graceful drain on SIGTERM.
license:         MIT
author:          Joshua Miller
maintainer:      joshua.ian.miller@pm.me
category:        Database
build-type:      Simple
homepage:        https://github.com/velveteer/arbiter
bug-reports:     https://github.com/velveteer/arbiter/issues

source-repository head
  type:     git
  location: https://github.com/velveteer/arbiter

common shared-properties
  default-language: GHC2024
  default-extensions: StrictData
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-home-modules -Wpartial-fields
    -Wredundant-constraints -Werror=incomplete-patterns
    -Wderiving-defaults -Wmissing-deriving-strategies
    -Wmissing-signatures

library
  import:         shared-properties
  hs-source-dirs: src
  exposed-modules:
    Arbiter.Serve
    Arbiter.Serve.Gauges
    Arbiter.Serve.Telemetry

  build-depends:
    , arbiter-core        <0.2
    , arbiter-hasql       <0.2
    , arbiter-servant     <0.2
    , arbiter-servant-ui  <0.2
    , arbiter-worker      <0.2
    , servant-server   >=0.19 && <0.21
    , aeson            >=2.0  && <2.3
    , async            >=2.2  && <2.3
    , base             >=4.14 && <5
    , bytestring       >=0.10 && <0.13
    , containers       >=0.6  && <0.9
    , hs-opentelemetry-api                  >=1.0 && <1.1
    , hs-opentelemetry-exporter-otlp        >=1.0 && <1.1
    , hs-opentelemetry-exporter-prometheus  >=1.0 && <1.1
    , hs-opentelemetry-instrumentation-wai  >=1.0 && <1.1
    , hs-opentelemetry-sdk                  >=1.0 && <1.1
    , hasql            >=1.9  && <1.11
    , http-types       >=0.12 && <0.13
    , stm              >=2.5  && <2.6
    , text             >=1.2  && <2.2
    , time             >=1.9  && <1.16
    , unix             >=2.7  && <2.9
    , unliftio         >=0.2  && <0.3
    , unliftio-core    >=0.2  && <0.3
    , vector           >=0.12 && <0.14
    , wai              >=3.2  && <3.3
    , warp             >=3.3  && <3.5

test-suite arbiter-serve-tests
  import:         shared-properties
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Spec.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , aeson
    , arbiter-core
    , arbiter-migrations
    , arbiter-serve
    , arbiter-simple
    , arbiter-test-common
    , arbiter-worker
    , async
    , base
    , bytestring
    , hspec
    , http-client
    , http-types
    , postgresql-simple
    , stm
    , text
    , time
    , unix
